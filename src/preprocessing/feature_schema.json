{
  "schema_version": "2.0.0",
  "version_note": "v2.0.0 migration: Synchronized schema with dataset v3. Renamed Height_cm->Height, Weight_kg->Weight, Waist_Circumference_cm->Waist_Circumference, LDL_Cholesterol->LDL, HDL_Cholesterol->HDL. Updated Clinical Family History fields (removed Obesity/NAFLD, added Family_History_CVD). Expanded Gut features to 20 taxa (22 total with Age/Gender) and removed Shannon_Diversity_Index. Consolidated Wearable features to 17 total (renamed CGM & sleep metrics, added HRV/Stress/Sleep_Efficiency/Exercise_Frequency).",
  "_notes": "Source of truth for the preprocessing unit's feature mapper.",
  "default_conflict_relative_threshold": 0.2,
  "metadata_fields": {
    "Patient_ID": {
      "type": "string",
      "required": true,
      "source": "system_generated",
      "note": "Assigned by the platform (account/session ID). Never searched for in a report. Never fed to any model -- pure identifier only."
    }
  },
  "shared_features": {
    "_note": "Age and Gender are real input features (not metadata) -- they appear in EVERY model's column_order and directly affect predictions.",
    "Age": {
      "type": "integer",
      "unit": "years",
      "required": true,
      "valid_range": [
        18,
        100
      ],
      "source": "report_extraction",
      "aliases": [
        "age",
        "agc",
        "patlent age"
      ]
    },
    "Gender": {
      "type": "categorical",
      "categories": [
        "Male",
        "Female"
      ],
      "required": true,
      "source": "report_extraction",
      "aliases": [
        "gender",
        "sex",
        "gcnder"
      ],
      "encoding": {
        "Male": 1,
        "Female": 0
      }
    }
  },
